{
  // yakkamon-chat-worker — the brain behind the "Ask me anything…" bar on yakkamonworld.com
  // Workers cannot be renamed after creation, so pick the name once.
  "name": "yakkamon-chat-worker",
  "main": "index.js",
  "compatibility_date": "2026-07-29",

  // Plain settings. Change them here (then push) or in the dashboard under
  // Settings → Variables and Secrets. The dashboard wins for secrets.
  "vars": {
    "MODEL": "claude-haiku-4-5",
    "ALLOWED_ORIGINS": "https://yakkamonworld.com,https://www.yakkamonworld.com",
    "KNOWLEDGE_URL": "https://yakkamonworld.com/chatbot-knowledge.json",
    "DAILY_CAP": "1500",
    "MAX_HISTORY": "6"
  },

  // Per-IP limit: 20 questions a minute. Free, no setup — the namespace_id is any
  // number that is unique within this worker. If your dashboard rejects this block,
  // delete it: the worker falls back to an in-memory limit.
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  // OPTIONAL — answer cache + daily counter. Create a KV namespace first
  // (Storage & Databases → KV → Create → "yakkamon-chat-kv"), paste its id below
  // and remove the leading // from the three lines. Without it everything still
  // works; you just lose the cache and the /status counter.
  // "kv_namespaces": [
  //   { "binding": "CHAT_KV", "id": "PASTE-KV-NAMESPACE-ID" }
  // ],

  "observability": { "enabled": true }
}
